{
  "name": "@heisreal/web",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "web",
    "sourceRoot": "apps/web/src",
    "tags": [
      "type:app",
      "scope:web"
    ],
    "targets": {
      "typecheck": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "default",
          "^default"
        ],
        "options": {
          "command": "tsc --noEmit -p apps/web/tsconfig.json"
        }
      },
      "prune": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "default",
          "^default",
          {
            "externalDependencies": [
              "next"
            ]
          },
          "{workspaceRoot}/tools/docker/next-web.Dockerfile"
        ],
        "outputs": [
          "{workspaceRoot}/apps/web/dist"
        ],
        "executor": "nx:run-commands",
        "options": {
          "cwd": "apps/web",
          "parallel": false,
          "commands": [
            "rm -rf dist",
            "cp -a .next/standalone dist",
            "cp -a .next/static dist/apps/web/.next/static",
            "if [ -d public ]; then cp -a public dist/apps/web/public; fi",
            "cp ../../tools/docker/next-web.Dockerfile dist/Dockerfile"
          ]
        }
      },
      "container": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prune"
        ],
        "options": {
          "command": "docker build -t ${IMAGE:-heisreal/web:local} apps/web/dist"
        }
      },
      "lint-rules": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/eslint.config.mjs",
          "{projectRoot}/eslint-token-boundary.test.mjs",
          "{workspaceRoot}/eslint.config.mjs",
          {
            "externalDependencies": [
              "eslint"
            ]
          }
        ],
        "options": {
          "command": "node --test apps/web/eslint-token-boundary.test.mjs"
        }
      },
      "lint": {
        "dependsOn": [
          "lint-rules"
        ]
      },
      "e2e": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prune"
        ],
        "cache": false,
        "outputs": [
          "{workspaceRoot}/test-output/e2e"
        ],
        "options": {
          "command": "playwright test -c apps/web/e2e/playwright.config.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "e2e-webkit": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prune"
        ],
        "cache": false,
        "outputs": [
          "{workspaceRoot}/test-output/e2e-webkit"
        ],
        "options": {
          "command": "tools/scripts/playwright-webkit.sh",
          "cwd": "{workspaceRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@clerk/react": "^6.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "next": "~16.3.8",
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@heisreal/contracts": "workspace:*",
    "@tailwindcss/postcss": "^4.3.3",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
