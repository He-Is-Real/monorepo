# Copy to apps/web/.env.local (git-ignored) for `pnpm nx dev web`. Public values only; on Cloud Run
# Terraform sets these (infra/terraform/modules/gcp/web.tf).
# The Clerk dev instance's publishable key (D32: Clerk runs in the browser only).
CLERK_PUBLISHABLE_KEY=pk_test_c3VwZXJiLW1pbmstODk2Ny5jbGVyay5hY2NvdW50cy5kZXYk
# api-public-read (server-side reads only, D32): local, or the dev service's public URL.
API_PUBLIC_READ_URL=http://localhost:3001
# The story the home page shows (the dev seed's, 0.9).
FEATURED_STORY_SLUG=test-story-walking-skeleton
# true = tell search engines not to index (dev on Cloud Run).
ROBOTS_NOINDEX=false
# The public origin for canonical URLs, Open Graph and the sitemap (optional locally).
SITE_URL=http://localhost:3000
