{
  "name": "@heisreal/dev-seed",
  "version": "0.0.1",
  "private": true,
  "exports": {
    "./testing": {
      "types": "./testing/index.ts",
      "import": "./testing/index.ts",
      "default": "./testing/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "dev-seed",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/dev-seed/dist/package.json",
          "{workspaceRoot}/apps/dev-seed/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/dev-seed/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/dev-seed/dist/patches",
          "{workspaceRoot}/apps/dev-seed/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/dev-seed/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules",
          "copy-dockerfile"
        ],
        "executor": "nx:noop"
      },
      "container": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prune"
        ],
        "options": {
          "command": "docker build -t ${IMAGE:-heisreal/dev-seed:local} apps/dev-seed/dist"
        }
      },
      "copy-dockerfile": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "{workspaceRoot}/tools/docker/nest-service.Dockerfile"
        ],
        "outputs": [
          "{workspaceRoot}/apps/dev-seed/dist/Dockerfile"
        ],
        "options": {
          "command": "cp tools/docker/nest-service.Dockerfile apps/dev-seed/dist/Dockerfile"
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/libs/database/integration/support/**/*",
          "{workspaceRoot}/libs/database/schema/**/*",
          "{workspaceRoot}/libs/legal/dpa/**/*",
          "{workspaceRoot}/libs/legal/forms/**/*",
          "{workspaceRoot}/infra/k8s/surrealdb/base/kustomization.yaml",
          {
            "externalDependencies": [
              "surrealdb",
              "vitest"
            ]
          }
        ],
        "outputs": [],
        "options": {
          "command": "vitest run --config vitest.integration.config.mts",
          "cwd": "{projectRoot}"
        }
      },
      "generate-media": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SWC_NODE_PROJECT=apps/dev-seed/tsconfig.app.json node -r @swc-node/register apps/dev-seed/src/media/generate.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "upload-media": {
        "executor": "nx:run-commands",
        "options": {
          "command": "SWC_NODE_PROJECT=apps/dev-seed/tsconfig.app.json node -r @swc-node/register apps/dev-seed/src/media/upload.ts",
          "cwd": "{workspaceRoot}"
        }
      },
      "behavioural": {
        "executor": "nx:run-commands",
        "cache": false,
        "options": {
          "command": "playwright test -c apps/dev-seed/behavioural/playwright.config.ts",
          "cwd": "{workspaceRoot}"
        }
      }
    },
    "tags": [
      "type:app",
      "scope:dev"
    ]
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.2.0",
    "@heisreal/consent": "workspace:*",
    "@heisreal/secrets": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "surrealdb": "^2.0.8",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@heisreal/database": "workspace:*"
  }
}
