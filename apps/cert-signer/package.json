{
  "name": "@heisreal/cert-signer",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "cert-signer",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/cert-signer/dist/package.json",
          "{workspaceRoot}/apps/cert-signer/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/cert-signer/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/cert-signer/dist/patches",
          "{workspaceRoot}/apps/cert-signer/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/cert-signer/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules",
          "copy-dockerfile"
        ],
        "executor": "nx:noop"
      },
      "container": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prune"
        ],
        "options": {
          "command": "docker build -t ${IMAGE:-heisreal/cert-signer:local} apps/cert-signer/dist"
        }
      },
      "copy-dockerfile": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "{workspaceRoot}/tools/docker/nest-service.Dockerfile"
        ],
        "outputs": [
          "{workspaceRoot}/apps/cert-signer/dist/Dockerfile"
        ],
        "options": {
          "command": "cp tools/docker/nest-service.Dockerfile apps/cert-signer/dist/Dockerfile"
        }
      }
    },
    "tags": [
      "type:app",
      "scope:ops"
    ]
  },
  "dependencies": {
    "@heisreal/logging": "workspace:*",
    "@heisreal/worker-identity": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "google-auth-library": "^11.1.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.3.2",
    "@types/express": "^5.0.6"
  }
}
