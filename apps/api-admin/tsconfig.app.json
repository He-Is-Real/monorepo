{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "out-tsc/app",
    "types": ["node"],
    "rootDir": "src",
    "tsBuildInfoFile": "out-tsc/app/tsconfig.app.tsbuildinfo",
    "resolveJsonModule": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021",
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts", "src/**/*.json"],
  "exclude": [
    "out-tsc",
    "dist",
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/story-cards/tsconfig.lib.json"
    },
    {
      "path": "../../libs/roles/tsconfig.lib.json"
    },
    {
      "path": "../../libs/http/tsconfig.lib.json"
    },
    {
      "path": "../../libs/health/tsconfig.lib.json"
    },
    {
      "path": "../../libs/secrets/tsconfig.lib.json"
    },
    {
      "path": "../../libs/database/tsconfig.lib.json"
    },
    {
      "path": "../../libs/contracts/tsconfig.lib.json"
    },
    {
      "path": "../../libs/auth/tsconfig.lib.json"
    }
  ]
}
