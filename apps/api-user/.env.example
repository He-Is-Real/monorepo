# Copy to apps/api-user/.env (git-ignored). Nx loads it for `pnpm nx serve api-user`.
# No secret values here: the password is read from Secret Manager at startup
# using your gcloud login (gcloud auth application-default login).
PORT=3002
GCP_PROJECT=heisreal-dev
SURREAL_URL=ws://localhost:8000
SURREAL_NAMESPACE=heisreal
SURREAL_DATABASE=main
SURREAL_USER=api_user
SURREAL_PASSWORD_SECRET=surreal-api-user-password
# Clerk session-token verification (task 0.5): all public values, no secrets. The dev
# instance's issuer and PEM public key; azp must be one of the allowed origins.
CLERK_ISSUER=https://superb-mink-8967.clerk.accounts.dev
CLERK_AUTHORIZED_PARTIES=http://localhost:3000
# One line with \n escapes (or copy the PEM from infra/terraform/live/dev/cluster/clerk.auto.tfvars).
CLERK_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8AMIIBCgKCAQEAs+x7KKkwQ13rwv9WnIzp\nQQOyb61U6Bp9BeHNRI0fV6U6cz+/fz8SVyDsy6GQEkrAzGXABCQe3amlC4HbhZml\nI4GulA1TeXMQGgMNhzhIrUk2n7pVh8gvg28z3iIJLO3syX2LaDI9w1ToSelMHbsd\n8UhwJEKFOsGTbCY0yY0SnF+WIy+hyds7yqs/r4gjB2Aw21eaKTjO7UTFsoTNXV6m\nfNR0QUNBFTDXDhc/ipv1jVkUxXmr84jsvx7AK0q9aho4JUMXwDJoqwwmEpaNbSVe\njxl6R9xytUgIEPeBfy2/WWN+OtJJxBUQp/xw6gBPsJ79wjaQKTu0Emrlq/vwEd/w\n4QIDAQAB\n-----END PUBLIC KEY-----"
