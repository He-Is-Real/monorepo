{
  "name": "@heisreal/api-public-read",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "api-public-read",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/api-public-read/dist/package.json",
          "{workspaceRoot}/apps/api-public-read/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/api-public-read/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/api-public-read/dist/patches",
          "{workspaceRoot}/apps/api-public-read/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/api-public-read/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules",
          "copy-dockerfile"
        ],
        "executor": "nx:noop"
      },
      "serve": {
        "continuous": true,
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "api-public-read:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "api-public-read:build:development"
          },
          "production": {
            "buildTarget": "api-public-read:build:production"
          }
        }
      },
      "container": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prune"
        ],
        "options": {
          "command": "docker build -t ${IMAGE:-heisreal/api-public-read:local} apps/api-public-read/dist"
        }
      },
      "copy-dockerfile": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "{workspaceRoot}/tools/docker/nest-service.Dockerfile"
        ],
        "outputs": [
          "{workspaceRoot}/apps/api-public-read/dist/Dockerfile"
        ],
        "options": {
          "command": "cp tools/docker/nest-service.Dockerfile apps/api-public-read/dist/Dockerfile"
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/libs/database/integration/support/**/*",
          "{workspaceRoot}/libs/database/schema/**/*",
          "{workspaceRoot}/libs/legal/dpa/**/*",
          "{workspaceRoot}/infra/k8s/surrealdb/base/kustomization.yaml",
          {
            "externalDependencies": [
              "surrealdb",
              "vitest"
            ]
          }
        ],
        "outputs": [],
        "options": {
          "command": "vitest run --config vitest.integration.config.mts",
          "cwd": "{projectRoot}"
        }
      }
    },
    "tags": [
      "type:app",
      "scope:api"
    ]
  },
  "dependencies": {
    "@heisreal/database": "workspace:*",
    "@heisreal/health": "workspace:*",
    "@heisreal/http": "workspace:*",
    "@heisreal/secrets": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-express": "^12.2.0",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.2",
    "surrealdb": "^2.0.8",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@heisreal/contracts": "workspace:*",
    "@heisreal/dev-seed": "workspace:*",
    "@nestjs/testing": "^12.2.0",
    "@types/express": "^5.0.6"
  }
}
