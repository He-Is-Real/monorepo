# Copy to apps/api-public-read/.env (git-ignored). Nx loads it for `pnpm nx serve api-public-read`.
# No secret values here: the password is read from Secret Manager at startup
# using your gcloud login (gcloud auth application-default login).
PORT=3001
GCP_PROJECT=heisreal-dev
SURREAL_URL=ws://localhost:8000
SURREAL_NAMESPACE=heisreal
SURREAL_DATABASE=main
SURREAL_USER=api_public_read
SURREAL_PASSWORD_SECRET=surreal-api-public-read-password
# Origins the browser may call this service from (D31): web's URL on Cloud Run, localhost here.
CORS_ALLOWED_ORIGINS=http://localhost:3000
