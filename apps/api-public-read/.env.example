# Copy to apps/api-public-read/.env (git-ignored). Nx loads it for `pnpm nx serve api-public-read`.
# No secret values here: the password is read from Secret Manager at startup
# using your gcloud login (gcloud auth application-default login).
PORT=3001
GCP_PROJECT=heisreal-dev
SURREAL_URL=ws://localhost:8000
SURREAL_NAMESPACE=heisreal
SURREAL_DATABASE=main
SURREAL_USER=api_public_read
SURREAL_PASSWORD_SECRET=surreal-api-public-read-password
# Origins the browser may call this service from (D31): web's URL on Cloud Run, localhost here.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Media signing (D52). Leave all five unset to run with signing off (media URLs are null), or
# set all five: identifiers only; the keys are read from Secret Manager (needs your access to
# the bunny-*-token-key secrets). Values: tools/scripts/tf.sh bunny output bunny
# BUNNY_STREAM_LIBRARY_ID=786537
# BUNNY_STREAM_CDN_HOST=vz-da4dce15-a49.b-cdn.net
# BUNNY_IMAGES_CDN_HOST=heisreal-dev-images.b-cdn.net
# BUNNY_STREAM_TOKEN_KEY_SECRET=bunny-stream-token-key
# BUNNY_IMAGES_TOKEN_KEY_SECRET=bunny-images-token-key
