{
  "name": "@heisreal/housekeeping",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "housekeeping",
    "targets": {
      "prune-lockfile": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "executor": "@nx/js:prune-lockfile",
        "inputs": [
          "default",
          "^default",
          "{workspaceRoot}/pnpm-workspace.yaml",
          "{workspaceRoot}/package.json",
          {
            "runtime": "node -e \"try{console.log('pnpm major '+require('child_process').execSync('pnpm --version',{stdio:['ignore','pipe','ignore']}).toString().trim().split('.')[0])}catch{console.log('pnpm major unavailable')}\""
          }
        ],
        "outputs": [
          "{workspaceRoot}/apps/housekeeping/dist/package.json",
          "{workspaceRoot}/apps/housekeeping/dist/pnpm-lock.yaml",
          "{workspaceRoot}/apps/housekeeping/dist/pnpm-workspace.yaml",
          "{workspaceRoot}/apps/housekeeping/dist/patches",
          "{workspaceRoot}/apps/housekeeping/dist/local_path_modules"
        ],
        "options": {
          "buildTarget": "build"
        }
      },
      "copy-workspace-modules": {
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "outputs": [
          "{workspaceRoot}/apps/housekeeping/dist/workspace_modules"
        ],
        "executor": "@nx/js:copy-workspace-modules",
        "options": {
          "buildTarget": "build"
        }
      },
      "prune": {
        "dependsOn": [
          "prune-lockfile",
          "copy-workspace-modules",
          "copy-dockerfile"
        ],
        "executor": "nx:noop"
      },
      "container": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "prune"
        ],
        "options": {
          "command": "docker build -t ${IMAGE:-heisreal/housekeeping:local} apps/housekeeping/dist"
        }
      },
      "copy-dockerfile": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "cache": true,
        "inputs": [
          "{workspaceRoot}/tools/docker/nest-service.Dockerfile"
        ],
        "outputs": [
          "{workspaceRoot}/apps/housekeeping/dist/Dockerfile"
        ],
        "options": {
          "command": "cp tools/docker/nest-service.Dockerfile apps/housekeeping/dist/Dockerfile"
        }
      },
      "test-integration": {
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/libs/database/integration/support/**/*",
          "{workspaceRoot}/libs/database/schema/**/*",
          "{workspaceRoot}/infra/k8s/surrealdb/base/kustomization.yaml",
          {
            "externalDependencies": [
              "surrealdb",
              "vitest"
            ]
          }
        ],
        "outputs": [],
        "options": {
          "command": "vitest run --config vitest.integration.config.mts",
          "cwd": "{projectRoot}"
        }
      }
    },
    "tags": [
      "type:app",
      "scope:ops"
    ]
  },
  "dependencies": {
    "@google-cloud/secret-manager": "^7.2.0",
    "@heisreal/database": "workspace:*",
    "@heisreal/secrets": "workspace:*",
    "@heisreal/story-cards": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "surrealdb": "^2.0.8",
    "tslib": "^2.3.0"
  }
}
