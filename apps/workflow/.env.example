# Copy to apps/workflow/.env (git-ignored). Nx loads it for `pnpm nx serve workflow`.
# No secret values here: the password is read from Secret Manager at startup
# using your gcloud login (gcloud auth application-default login).
PORT=3004
GCP_PROJECT=heisreal-dev
SURREAL_URL=ws://localhost:8000
SURREAL_NAMESPACE=heisreal
SURREAL_DATABASE=main
SURREAL_USER=workflow
SURREAL_PASSWORD_SECRET=surreal-workflow-password
# The log keys' Secret Manager names (OpenTofu sets them on Cloud Run). Unset: fixed development
# keys, so local runs never need a real one.
# LOG_HMAC_SECRET=log-hmac
# LOG_SEARCH_HMAC_SECRET=log-search-hmac
