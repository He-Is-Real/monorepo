{
  "name": "@heisreal/auth",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "auth",
    "tags": [
      "type:lib",
      "scope:shared"
    ],
    "targets": {
      "test-integration": {
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/libs/database/integration/support/**/*",
          "{workspaceRoot}/infra/k8s/surrealdb/base/kustomization.yaml",
          {
            "externalDependencies": [
              "surrealdb",
              "jest"
            ]
          }
        ],
        "outputs": [],
        "options": {
          "command": "jest --config jest.integration.config.cts",
          "cwd": "{projectRoot}"
        }
      },
      "test": {
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/infra/clerk/dev.json",
          "{workspaceRoot}/infra/terraform/live/dev/cluster/clerk.auto.tfvars",
          "{workspaceRoot}/libs/contracts/openapi/components.yaml",
          "{workspaceRoot}/libs/database/schema/access-clerk.surql",
          "{workspaceRoot}/apps/api-user/.env.example",
          "{workspaceRoot}/apps/api-admin/.env.example"
        ]
      }
    }
  },
  "dependencies": {
    "@heisreal/consent": "workspace:*",
    "@heisreal/database": "workspace:*",
    "@heisreal/secrets": "workspace:*",
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.0.0",
    "surrealdb": "^2.0.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
