{
  "name": "@heisreal/consent",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./testing": {
      "types": "./src/testing.ts",
      "import": "./src/testing.ts",
      "default": "./src/testing.ts"
    },
    "./evidence": {
      "types": "./src/evidence.ts",
      "import": "./src/evidence.ts",
      "default": "./src/evidence.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "consent",
    "tags": [
      "type:lib",
      "scope:shared"
    ],
    "targets": {
      "test-integration": {
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/libs/database/integration/support/**/*",
          "{workspaceRoot}/libs/legal/dpa/**/*",
          "{workspaceRoot}/libs/legal/forms/**/*",
          "{workspaceRoot}/libs/legal/terms/**/*",
          "{workspaceRoot}/infra/k8s/surrealdb/base/kustomization.yaml",
          {
            "externalDependencies": [
              "surrealdb",
              "vitest"
            ]
          }
        ],
        "outputs": [],
        "options": {
          "command": "vitest run --config vitest.integration.config.mts",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@heisreal/database": "workspace:*",
    "@heisreal/roles": "workspace:*",
    "@heisreal/secrets": "workspace:*",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "surrealdb": "^2.0.8"
  },
  "devDependencies": {
    "@types/express": "^5.0.6"
  }
}
