{
  "name": "@heisreal/database",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./integration-testing": {
      "types": "./integration/support/index.ts",
      "import": "./integration/support/index.ts",
      "default": "./integration/support/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "database",
    "tags": [
      "type:lib",
      "scope:shared"
    ],
    "targets": {
      "test-integration": {
        "executor": "nx:run-commands",
        "inputs": [
          "default",
          "^production",
          "{workspaceRoot}/libs/legal/dpa/**/*",
          "{workspaceRoot}/libs/legal/forms/**/*",
          "{workspaceRoot}/infra/k8s/surrealdb/base/kustomization.yaml",
          "{workspaceRoot}/infra/k8s/surrealdb/base/init.surql.tmpl",
          "{workspaceRoot}/infra/k8s/surrealdb/base/identity_check.py",
          {
            "externalDependencies": [
              "surrealdb",
              "vitest"
            ]
          }
        ],
        "outputs": [],
        "options": {
          "command": "vitest run --config vitest.integration.config.mts",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "@heisreal/secrets": "workspace:*",
    "@nestjs/common": "^12.2.0",
    "surrealdb": "^2.0.8"
  },
  "devDependencies": {
    "@heisreal/contracts": "workspace:*"
  }
}
