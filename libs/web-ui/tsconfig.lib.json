{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "types": [],
    "lib": ["dom", "dom.iterable", "es2022"],
    "rootDir": "src",
    "jsx": "react-jsx",
    "module": "esnext",
    "moduleResolution": "bundler",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo"
  },
  "exclude": ["out-tsc", "dist", "eslint.config.mjs"],
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
