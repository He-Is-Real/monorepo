{
  "name": "@heisreal/web-ui",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./theme.css": "./src/styles/theme.css",
    "./eslint": "./eslint/index.mjs",
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "web-ui",
    "tags": [
      "type:lib",
      "scope:web"
    ],
    "targets": {
      "lint-rules": {
        "executor": "nx:run-commands",
        "cache": true,
        "inputs": [
          "{projectRoot}/eslint/**/*",
          "{workspaceRoot}/eslint.config.mjs",
          {
            "externalDependencies": [
              "eslint",
              "typescript-eslint"
            ]
          }
        ],
        "options": {
          "command": "node --test libs/web-ui/eslint/rules.test.mjs"
        }
      },
      "lint": {
        "dependsOn": [
          "lint-rules"
        ]
      }
    }
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "radix-ui": "^1.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "radix-ui": "^1.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  }
}
