# D42: what the automatic cluster plan's identity (tf-cluster-planner, ${planner}) may do in
# Kubernetes, applied by planner_rbac.tf and tested on kind with this same file
# (modules/cluster/tests/planner-dry-run-only.sh).
#
# 1. A Role in `database`: get, create and patch on the kinds the overlay and migration.tf /
#    identity.tf apply there, which is what the kustomization provider's server-side dry runs
#    need (Kubernetes authorises a dry run like the real request). No Secrets, no list, no
#    delete, nothing cluster-scoped. Its Google identity has no Kubernetes IAM role beyond
#    reaching the cluster (modules/bootstrap/ci_identity.tf), so this Role is all it can do.
# 2. A ValidatingAdmissionPolicy that rejects every write from that user to the Role's kinds,
#    in every namespace, unless it is a dry run (every other write is already refused by RBAC). So the Role's create/patch can only ever be dry
#    runs: a planner token, even from an edited workflow, can't create a Job, change the
#    StatefulSet or anything else. (Reads aren't admission-checked; the Role limits them.)
#    Kubernetes >= 1.30 (GA); the cluster is on the Regular channel.
- apiVersion: rbac.authorization.k8s.io/v1
  kind: Role
  metadata:
    name: terraform-cluster-plan
    namespace: database
  rules:
    - apiGroups: ['']
      resources: [configmaps, serviceaccounts, services, resourcequotas]
      verbs: [get, create, patch]
    - apiGroups: [apps]
      resources: [statefulsets]
      verbs: [get, create, patch]
    - apiGroups: [batch]
      resources: [jobs, cronjobs]
      verbs: [get, create, patch]
    - apiGroups: [networking.k8s.io]
      resources: [networkpolicies]
      verbs: [get, create, patch]
    - apiGroups: [external-secrets.io]
      resources: [externalsecrets, secretstores]
      verbs: [get, create, patch]
- apiVersion: rbac.authorization.k8s.io/v1
  kind: RoleBinding
  metadata:
    name: terraform-cluster-plan
    namespace: database
  roleRef:
    apiGroup: rbac.authorization.k8s.io
    kind: Role
    name: terraform-cluster-plan
  subjects:
    - apiGroup: rbac.authorization.k8s.io
      kind: User
      name: '${planner}' # GKE maps the Google identity's email to the user name
- apiVersion: admissionregistration.k8s.io/v1
  kind: ValidatingAdmissionPolicy
  metadata:
    name: terraform-cluster-plan-dry-run-only
  spec:
    failurePolicy: Fail
    matchConstraints:
      # Exactly the kinds the Role above lets the planner write (anything else is already refused
      # by RBAC). Not '*/*': GKE Autopilot rejects admission rules on every resource.
      resourceRules:
        - apiGroups: ['']
          apiVersions: ['*']
          operations: [CREATE, UPDATE, DELETE, CONNECT]
          resources: [configmaps, serviceaccounts, services, resourcequotas]
        - apiGroups: [apps]
          apiVersions: ['*']
          operations: [CREATE, UPDATE, DELETE, CONNECT]
          resources: [statefulsets]
        - apiGroups: [batch]
          apiVersions: ['*']
          operations: [CREATE, UPDATE, DELETE, CONNECT]
          resources: [jobs, cronjobs]
        - apiGroups: [networking.k8s.io]
          apiVersions: ['*']
          operations: [CREATE, UPDATE, DELETE, CONNECT]
          resources: [networkpolicies]
        - apiGroups: [external-secrets.io]
          apiVersions: ['*']
          operations: [CREATE, UPDATE, DELETE, CONNECT]
          resources: [externalsecrets, secretstores]
    matchConditions:
      - name: is-cluster-planner
        expression: "request.userInfo.username == '${planner}'"
    validations:
      - expression: 'has(request.dryRun) && request.dryRun == true'
        message: 'tf-cluster-planner may only send dry-run requests (D42; infra/terraform/README.md)'
        reason: Forbidden
- apiVersion: admissionregistration.k8s.io/v1
  kind: ValidatingAdmissionPolicyBinding
  metadata:
    name: terraform-cluster-plan-dry-run-only
  spec:
    policyName: terraform-cluster-plan-dry-run-only
    validationActions: [Deny]
