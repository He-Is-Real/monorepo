(assertion.ref == 'refs/heads/main'
  && assertion.event_name == 'workflow_dispatch'
  && assertion.job_workflow_ref == assertion.workflow_ref
  && assertion.workflow_ref in ['${repository}/.github/workflows/reset-dev-data.yml@refs/heads/main',
    '${repository}/.github/workflows/dev-behavioural-tests.yml@refs/heads/main'])
  ? 'allowed' : 'denied'
