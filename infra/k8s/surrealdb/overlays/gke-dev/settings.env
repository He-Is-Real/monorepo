# Dev values (non-secret). Must match the gcp root's outputs: the cluster
# root refuses to plan if they drift.
GCP_PROJECT=heisreal-dev
GKE_CLUSTER_NAME=heisreal-dev
GKE_CLUSTER_LOCATION=europe-west2
BACKUP_BUCKET=heisreal-dev-db-backups
SECRETS_GSA=surrealdb-secrets@heisreal-dev.iam.gserviceaccount.com
BACKUP_GSA=surrealdb-backup@heisreal-dev.iam.gserviceaccount.com
RUN_SUBNET_CIDR=10.10.16.0/26
