{
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "name": "surrealdb-k8s",
  "projectType": "application",
  "tags": ["type:infra", "scope:database"],
  "targets": {
    "validate": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/**/*",
        { "runtime": "kubeconform -v 2>/dev/null || echo missing" },
        {
          "runtime": "kubectl version --client -o json 2>/dev/null | jq -r .kustomizeVersion"
        }
      ],
      "options": {
        "command": "infra/k8s/surrealdb/scripts/validate.sh"
      }
    },
    "local-up": {
      "executor": "nx:run-commands",
      "options": {
        "command": "kubectl --context kind-heisreal -n database scale statefulset/surrealdb --replicas=1"
      }
    },
    "local-down": {
      "executor": "nx:run-commands",
      "options": {
        "command": "kubectl --context kind-heisreal -n database scale statefulset/surrealdb --replicas=0"
      }
    }
  }
}
