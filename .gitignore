# env files are committed (Joel, 2026-11-14): they hold config and Secret Manager secret
# NAMES only, never secret values (see README "Secrets"); gitleaks scans them in CI and pre-commit.

# OpenTofu: plans, state and crash logs never belong in git (state lives in GCS).
*.tfplan
*.tfplan.json
tfplan
*.tfstate
*.tfstate.*
crash.log
crash.*.log
.terraform/
.terraform.tfstate.lock.info

test-output
# Playwright's default output folder (our configs write to test-output/)
test-results

# Next.js
.next
/apps/web/out

# surreal sql REPL history (written to the working directory)
history.txt

# Agent tooling generated by Nx; not vendored
.agents/
.codex/
.claude/

# Generated by Next.js
next-env.d.ts
.swc

# Python bytecode (libs/database/schema/migrate.py)
__pycache__/

# Written by `next dev` when agentRules is on (apps/web/next.config.js turns it off)
/apps/web/AGENTS.md
/apps/web/CLAUDE.md

vitest.config.*.timestamp*
*.tsbuildinfo
